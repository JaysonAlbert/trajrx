{
  "name": "trajrx",
  "version": "0.2.0",
  "description": "TrajRx — IDE agent trajectory analysis and efficiency attribution pipeline",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "trajrx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "PLAN.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build",
    "start": "node dist/cli.js",
    "dev": "tsx src/cli.ts",
    "analyze": "node dist/cli.js",
    "test:fixture": "node -e \"console.error('Add a local .jsonl under test/fixtures/ (gitignored). See test/fixtures/README.md'); process.exit(1)\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "trajrx",
    "cursor",
    "agent",
    "trajectory",
    "transcript",
    "attribution",
    "observability",
    "llm"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitepress": "^1.6.4"
  },
  "repository": {
    "type": "git",
    "url": "."
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "listr2": "^10.2.1",
    "picocolors": "^1.1.1",
    "string-width": "^8.2.1"
  }
}
